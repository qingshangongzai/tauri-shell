{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "我的应用 安装向导",
  "version": "1.0.0",
  "identifier": "com.mycompany.myapp.installer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "我的应用 安装向导",
        "width": 760,
        "height": 520,
        "resizable": false,
        "center": true,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
