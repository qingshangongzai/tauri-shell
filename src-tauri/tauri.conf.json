{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "我的应用",
  "version": "0.1.0",
  "identifier": "com.mycompany.myapp",
  "build": {
    "frontendDist": "../dist-min",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "node sync-version.cjs && npx serve dist -p 1420 -s --no-clipboard",
    "beforeBuildCommand": "node sync-version.cjs && node scripts/gen-icons.mjs && node minify.cjs"
  },
  "app": {
    "windows": [
      {
        "title": "我的应用",
        "width": 900,
        "height": 600,
        "resizable": true,
        "decorations": false,
        "center": true,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,ElasticOverscroll,OverscrollHistoryNavigation"
      },
      {
        "label": "tray-menu",
        "url": "tray-menu.html",
        "width": 220,
        "height": 120,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,ElasticOverscroll,OverscrollHistoryNavigation"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
